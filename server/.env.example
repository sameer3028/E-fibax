# ---------------------------------------------------------------------------
# Fibax Pharma — server environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Port the Node server listens on.
# On Hostinger's "Setup Node.js App" this is provided automatically; leave as-is.
PORT=5000

# Node environment
NODE_ENV=production

# ---------------------------------------------------------------------------
# Storage driver: "json" | "postgres" (Supabase) | "mysql"
#   - Local development: "json" (no database needed).
#   - Production on Hostinger managed Supabase: "postgres".
# ---------------------------------------------------------------------------
STORAGE_DRIVER=postgres

# ---------------------------------------------------------------------------
# Hostinger managed Supabase (recommended — HTTPS REST, no DB ports needed)
# Copy both values from the Hostinger database panel:
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_API_KEY=

# ---------------------------------------------------------------------------
# Alternative: direct Postgres connection (only if outbound 5432/6543 works).
# Preferred form is the full connection string; otherwise use the individual
# DB_* fields below.
# ---------------------------------------------------------------------------
DATABASE_URL=

# DB_HOST=
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true

DB_POOL_LIMIT=5

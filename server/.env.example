# ---------------------------------------------------------------------------
# Fibax Pharma — server environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Port the Node server listens on.
# On Hostinger's "Setup Node.js App" this is provided automatically; leave as-is.
PORT=5000

# Node environment
NODE_ENV=production

# ---------------------------------------------------------------------------
# Storage driver: "json" | "postgres" (Supabase) | "mysql"
#   - Local development: "json" (no database needed).
#   - Production on Supabase: "postgres".
# ---------------------------------------------------------------------------
STORAGE_DRIVER=postgres

# ---------------------------------------------------------------------------
# PostgreSQL / Supabase connection
# Preferred: paste the full connection string from Supabase
#   (Project Settings > Database > Connection string > URI).
# Use the "Connection pooling" (Transaction) URI for serverless-style hosts.
# Example shape (fill in your own — do not commit real credentials):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ---------------------------------------------------------------------------
DATABASE_URL=

# Optional: instead of DATABASE_URL, set individual fields.
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.<ref>
# Set the database password you created in Supabase:
# DB_PASSWORD=
# DB_SSL=true

DB_POOL_LIMIT=5

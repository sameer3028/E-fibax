# ---------------------------------------------------------------------------
# Fibax Pharma — server environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Port the Node server listens on.
# On Hostinger's "Setup Node.js App" this is provided automatically; leave as-is.
PORT=5000

# Node environment
NODE_ENV=production

# ---------------------------------------------------------------------------
# Storage driver: "json" (local files) or "mysql" (production database)
#   - Local development: leave as "json" (no database needed).
#   - Hostinger / production: set to "mysql" and fill in the DB_* values.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=mysql

# ---------------------------------------------------------------------------
# MySQL connection (create the database + user in Hostinger hPanel > Databases)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uXXXXXXXX_fibax
DB_USER=uXXXXXXXX_fibax
DB_PASSWORD=change_me_strong_password
DB_POOL_LIMIT=5

{
  "name": "fibax-pharma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "sitemap": "node scripts/generate-sitemap.js",
    "build": "node scripts/generate-sitemap.js && npm run build --prefix client",
    "install:all": "npm install --prefix client && npm install --prefix server",
    "test": "node server/tests/run_tests.js",
    "backup": "node server/scripts/data-guard.js backup",
    "verify-data": "node server/scripts/data-guard.js verify",
    "restore-backup": "node server/scripts/data-guard.js restore",
    "setup": "npm install --prefix server && npm install --prefix client && npm run build",
    "postinstall": "npm run setup"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0"
  }
}

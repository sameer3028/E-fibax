# =================================================================
# FIBAX AYURVEDA WEB PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT.
# =================================================================

# Server runtime
NODE_ENV=production
PORT=5050
APP_URL=https://fibaxpharma.com

# Storage driver selection: "json" (default), "postgres" / "supabase", or "mysql"
STORAGE_DRIVER=json

# =================================================================
# DATABASE CONFIGURATION (Optional - only required if STORAGE_DRIVER is postgres or mysql)
# =================================================================
# PostgreSQL / Supabase direct URI:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Supabase REST API (for shared hosting environments with restricted outbound DB ports):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_API_KEY=your-supabase-service-role-key

# MySQL configuration:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=fibax_user
# DB_PASSWORD=your_database_password
# DB_NAME=fibax_db
# DB_POOL_LIMIT=5

# =================================================================
# PAYMENT GATEWAY (Razorpay)
# =================================================================
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# =================================================================
# LOGISTICS & SHIPPING (Delhivery)
# =================================================================
# Delhivery credentials can be configured here or in the Admin Portal (shipping_config.json)
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_MODE=production
DELHIVERY_CLIENT_NAME=FIBAX_AYURVEDA

# =================================================================
# PRODUCTION SMTP / TRANSACTIONAL EMAIL
# =================================================================
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@fibaxpharma.com
SMTP_PASSWORD=your_secure_smtp_password
SMTP_FROM_NAME="Fibax Ayurveda"
SMTP_FROM_EMAIL=orders@fibaxpharma.com

# =================================================================
# UPLOADS & FILE STORAGE
# =================================================================
# Custom absolute path for uploads (defaults to server/uploads)
# UPLOADS_DIR=/var/www/fibax/server/uploads
